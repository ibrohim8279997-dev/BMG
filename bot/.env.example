# BMG Telegram bot (separate service). Same bot token as the backend uses for login codes.
TELEGRAM_BOT_TOKEN=
# Backend base URL reachable from the bot (internal address is fine), e.g. http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
# Must equal BOT_API_SECRET in backend/.env (long random string)
BOT_API_SECRET=
# Public site address used in links (https in production so Telegram shows a button)
SITE_URL=https://bmg.example.uz
