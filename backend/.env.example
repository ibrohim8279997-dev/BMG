# --- core
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bmg.example.uz
CSRF_TRUSTED_ORIGINS=https://bmg.example.uz
SITE_URL=https://bmg.example.uz
NUM_PROXIES=1                      # reverse proxies in front (Next.js proxy counts as 1; add nginx etc.)
# SQLite by default. PostgreSQL: postgres://user:pass@host:5432/bmg
DATABASE_URL=sqlite:///db.sqlite3
PRIVATE_MEDIA_ROOT=/var/bmg/private_media   # uploaded files, OUTSIDE the web root
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache   # use Redis in production (rate limits)

# --- Telegram bot (login only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=long-random-string
LOGIN_CODE_TTL_SECONDS=150
LOGIN_CODE_MAX_ATTEMPTS=5
MAX_NEW_ACCOUNTS_PER_IP_PER_DAY=5

# --- Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_ALLOWED_IPS=                 # comma-separated Click callback IPs (empty = all callbacks denied in production)

# --- Admin panel
ADMIN_ALLOWED_IPS=                 # comma-separated; empty = admin login denied in production
ADMIN_SESSION_SECONDS=7200

# --- AI providers (any subset; tried in AI_PROVIDERS order)
AI_PROVIDERS=claude,openai,gemini,grok,groq
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-3
GROQ_MODEL=llama-3.3-70b-versatile
AI_WEB_SEARCH=1
