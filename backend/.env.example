# --- core
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bmg.example.uz
CSRF_TRUSTED_ORIGINS=https://bmg.example.uz
SITE_URL=https://bmg.example.uz
# reverse proxies in front (Next.js proxy counts as 1; add nginx etc.)
NUM_PROXIES=1
# SQLite by default. PostgreSQL: postgres://user:pass@host:5432/bmg
DATABASE_URL=sqlite:///db.sqlite3
# uploaded files, OUTSIDE the web root
PRIVATE_MEDIA_ROOT=/var/bmg/private_media
# production: Redis (rate limits shared by all workers)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# dev without Redis: CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=redis://127.0.0.1:6379/1

# --- Telegram bot (login only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=long-random-string
LOGIN_CODE_TTL_SECONDS=150
LOGIN_CODE_MAX_ATTEMPTS=5
MAX_NEW_ACCOUNTS_PER_IP_PER_DAY=5

# --- Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# comma-separated Click callback IPs (empty = all callbacks denied in production)
CLICK_ALLOWED_IPS=

# --- Nexio CRM integration
# https://... given by the CRM team; empty = events are queued, nothing is sent
CRM_BASE_URL=https://crm.nexiolab.uz
# nxk_... (scope crm.write)
CRM_API_KEY=nxk_6e6df9cb42fac1a76a8e2b4366e5b7b9fb0b170fa2233bfe
# HMAC-SHA256 secret shared with the CRM
CRM_WEBHOOK_SECRET=
# long random string; the CRM sends it as Bearer to /api/crm/v1/* (empty = API off)
BMG_CRM_READ_KEY=
# comma-separated CRM server IPs (empty = any IP, key still required)
CRM_READ_ALLOWED_IPS=
CRM_READ_RATE=120/min

# --- Admin panel
# comma-separated; empty = admin login denied in production
ADMIN_ALLOWED_IPS=
ADMIN_SESSION_SECONDS=7200

# --- AI providers (any subset; tried in AI_PROVIDERS order)
AI_PROVIDERS=claude,openai,gemini,grok,groq
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-3
GROQ_MODEL=llama-3.3-70b-versatile
AI_WEB_SEARCH=1

# --- E-mail login (SMTP; leave EMAIL_HOST empty in dev: codes print to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=BMG <no-reply@bmg.uz>
GOOGLE_CLIENT_ID=

# --- Separate Telegram bot service (bot/): shared secret for /api/v1/bot/*; empty = bot API off
BOT_API_SECRET=
BOT_LOGIN_TTL_SECONDS=300

# --- Captcha on registration (Cloudflare Turnstile, free). Empty = off (IP limit still applies)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Accounting PDFs: path to a TTF font with Cyrillic glyphs (default: DejaVuSans / Arial if found)
# PDF_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
