DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite by default; for PostgreSQL: postgres://user:pass@host:5432/bmg
DATABASE_URL=sqlite:///db.sqlite3
# Telegram bot (login only). Token is set ONLY here / in the server environment.
TELEGRAM_BOT_TOKEN=
LOGIN_CODE_TTL_SECONDS=150
LOGIN_CODE_MAX_ATTEMPTS=5
